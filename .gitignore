# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local agent tooling — machine-specific, not part of this project
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Uncompressed source assets. `source/Lady Justice.glb` is ~91 MB, which would
# bloat every clone forever; the build only needs the optimised
# public/models/statue.glb (1.7 MB), which IS committed. Regenerate it with:
#   npx gltf-transform optimize "source/Lady Justice.glb" public/models/statue.glb \
#     --compress meshopt --simplify-ratio 0.1 --simplify-error 0.01 --texture-compress false
/source/
